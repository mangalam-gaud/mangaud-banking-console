# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
#
# The database name is part of the application, not an accident. It must be
# `mangaud` - `server/src/config/index.ts` refuses to start in production
# without MONGODB_URI, and its development fallback is also `mangaud`, so a
# missing value can never quietly land you on a different, empty database.
#
# This MongoDB instance is shared with other projects on this machine, so
# `show databases` lists their databases too. `mangaud` is the only one that
# belongs to this app. GET /api/v1/ready reports the name it is actually
# attached to.
MONGODB_URI=mongodb://localhost:27017/mangaud
MONGODB_URI_TEST=mongodb://localhost:27017/mangaud_test

# Money-integrity tests (optional, off by default)
#
# `npm run test:money` proves what two concurrent writes do to the same account:
# one credit for four simultaneous reversals, no overdraft for eight
# simultaneous repayments. It cannot prove anything without a real database, so
# it is opt-in and `npm test` stays pure-logic and fast. It runs against
# MONGODB_URI_TEST, never the demo database. Set this to 1 to enable it.
# RUN_MONEY_TESTS=1

# JWT Configuration
#
# Replace both before deploying anywhere. The server refuses to start in
# production while these are still the placeholder values below.
#
# Generate them with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-48-byte-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-random-48-byte-hex-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Origins allowed to call the API with credentials. Comma-separated.
#
# 3000 is the app (both `start.bat` modes and `npm run dev`). 8080 is the
# production preview, which proxies the API itself, so it does not strictly
# need listing - it is here to keep the API from logging a spurious block.
#
# Add your machine's LAN address if you want to reach the app from a phone;
# find it with `ipconfig`, or read it off the line `start.bat` prints.
# Anything not on this list is refused, so a new Wi-Fi network means an edit
# here.
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_AUTH_REQUESTS=20

# Logging
# One of: error, warn, info, debug
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=12
# Number of proxies in front of the app. 0 when Node is exposed directly, which
# is the case here - setting it to 1 without a proxy lets any client forge its
# own IP via X-Forwarded-For and walk straight past the rate limiter.
TRUST_PROXY_HOPS=0
